# ---- Database ----
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gachard?retryWrites=true&w=majority
DATABASE_NAME=gachard

# ---- Auth ----
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Demo/sandbox login tanpa Google OAuth. Set "true" untuk mengaktifkan.
ENABLE_DEMO_LOGIN=true

# AES-256-GCM key (min 32 karakter) untuk mengenkripsi private key wallet custodial di MongoDB
ENCRYPTION_SECRET_KEY=your-32-char-min-secret-key-here!!

# ---- BNB Chain Testnet ----
ADMIN_WALLET_ADDRESS=0x...
ADMIN_PRIVATE_KEY=0x...
BSC_TESTNET_RPC=https://bsc-testnet.bnbchain.org
CHAIN_ID=97
CONTRACT_ADDRESS=0x...
NEXT_PUBLIC_CONTRACT_ADDRESS=0x...

# ---- AI ----
# Gemini: market insight + price suggestion di marketplace (ADR-024).
# Catatan: AI vision untuk scan kartu DITUNDA (ADR-022), key ini tidak dipakai untuk itu.
GEMINI_API_KEY=your-gemini-api-key

# MiMo: risk scoring untuk AI Anomaly Detection Oracle (ADR-025)
MIMO_API_KEY=your-mimo-api-key
MIMO_BASE_URL=https://your-mimo-endpoint
MIMO_MODEL=mimo-v2.5-pro

# ---- Admin Console (Basic Auth) ----
# Generate nilai acak, jangan pakai ulang kredensial lain
ADMIN_USERNAME=your-admin-username
ADMIN_PASSWORD=your-admin-password
